# 로컬 개발 설정
# application.yml의 local 프로필이 사용하는 MySQL 비밀번호 (IntelliJ 실행 구성의 환경변수로도 설정 가능)
LOCAL_DB_PASSWORD=

# docker 관련 설정
MYSQL_DATABASE=wool
MYSQL_USER=wool
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

BACKEND_PORT=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 외부 API 설정
# STT: Groq Whisper
GROQ_API_KEY=
# 위기 표현 감지: Upstage Solar
UPSTAGE_API_KEY=

# 업로드한 파일(손편지 사진 등)을 저장하는 폴더. 비우면 실행 위치의 ./uploads를 쓴다.
# 운영에서는 컨테이너를 다시 띄워도 남도록 영구 볼륨 경로를 지정한다.
FILE_STORAGE_DIR=
