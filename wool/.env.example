# 로컬 개발 설정
# application.yml의 local 프로필이 사용하는 MySQL 비밀번호 (IntelliJ 실행 구성의 환경변수로도 설정 가능)
LOCAL_DB_PASSWORD=

# docker 관련 설정
MYSQL_DATABASE=wool
MYSQL_USER=wool
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

BACKEND_PORT=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 외부 API 설정
# STT: Groq Whisper
GROQ_API_KEY=
# 위기 표현 감지: Upstage Solar
UPSTAGE_API_KEY=

# AWS S3 설정 (파일 저장소가 S3로 정해지면 주석 해제, 미정)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET_NAME=
